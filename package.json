{
  "name": "vj_bot",
  "version": "1.0.0",
  "description": "VJBot: lớp học đảo ngược luyện JLPT N5–N1 cùng thầy Lâm (AI). Cloudflare Workers + D1, tại https://vjbot.dangphuc.me",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "teacher:catalog": "node scripts/build_teacher_catalog.mjs",
    "predev": "npm run teacher:catalog",
    "prebuild": "npm run teacher:catalog",
    "predeploy": "npm run teacher:catalog",
    "dev": "cf dev --port 8787",
    "build": "cf deploy --dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:python": "PYTHONPATH=. .venv/bin/pytest tests/ -q",
    "data:import": "python3 scripts/import_lessons.py",
    "deploy": "cf deploy",
    "migrate": "cf d1 migrations apply eb0d49a5-7a90-4219-968c-5fcb04390859 --dir migrations",
    "release": "npm run migrate && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silent9669/VJ_BOT.git"
  },
  "keywords": [
    "japanese",
    "jlpt",
    "jlpt-n5-n1",
    "reversed-classroom",
    "cloudflare-workers",
    "cloudflare-d1",
    "openai",
    "claude",
    "gemini",
    "webrtc",
    "spaced-repetition",
    "vietnamese"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/silent9669/VJ_BOT/issues"
  },
  "homepage": "https://vjbot.dangphuc.me",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.5",
    "cf": "^1.0.0-beta.23",
    "esbuild": "^0.28.2",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "jose": "^6.2.14"
  },
  "engines": {
    "node": ">=22.13"
  }
}
