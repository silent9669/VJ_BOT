# Copy to .dev.vars for local `npm run dev` (never commit .dev.vars).
# Comma list of Google emails that become admin after Google sign-in
ADMIN_EMAILS=
# Any long random string; encrypts learners' saved API keys
AI_KEY_SECRET=
GOOGLE_CLIENT_ID=

# Antigravity chat uses a dedicated CLIProxyAPI v8 gateway, not a Google Cloud OAuth client.
# Use HTTPS for a remote gateway. Keep these server-side keys out of browser storage and Git.
ANTIGRAVITY_GATEWAY_URL=
ANTIGRAVITY_MANAGEMENT_KEY=
ANTIGRAVITY_API_KEY=
# Local preview only; production must not enable loopback routing.
ANTIGRAVITY_ALLOW_LOOPBACK=false
